# Environment Variables for Production
# These will be set in the Vercel dashboard

# Database URL (will be set in Vercel environment)
# DATABASE_URL="your-production-database-url"

# TON Network Configuration
TON_NETWORK="mainnet"  # or "testnet"

# Application Configuration
NEXT_PUBLIC_APP_NAME="TON x Ignyte Web3 Payments"
NEXT_PUBLIC_APP_DESCRIPTION="Web3 payment solution for Telegram"

# For local development, you can uncomment and set these:
# DATABASE_URL="postgresql://user:password@localhost:5432/tonignyte?schema=public"